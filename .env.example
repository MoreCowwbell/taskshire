# Copy to `.env` (git-ignored) and point at wherever you unzipped the raw KayKit packs.
# `npm run assets` reads this; the built glbs are checked in, so it is optional.
#
# Anything already in the environment wins over this file.
# Windows: ASSETS_SRC=D:\data\taskshire\assets-src
# macOS:   ASSETS_SRC=~/data/taskshire/assets-src
ASSETS_SRC=./assets-src
