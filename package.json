{
  "name": "taskshire",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Your coding-agent threads as a medieval village: a fork of Bot Crossing where every thread on your machine is a villager building something.",
  "license": "MIT",
  "author": "Jarren Rocks",
  "homepage": "https://github.com/MoreCowwbell/taskshire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoreCowwbell/taskshire.git"
  },
  "bugs": {
    "url": "https://github.com/MoreCowwbell/taskshire/issues"
  },
  "keywords": [
    "claude-code",
    "coding-agent",
    "three.js",
    "webgl",
    "colony-sim",
    "developer-tools",
    "visualization"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "os": [
    "darwin",
    "win32",
    "linux"
  ],
  "scripts": {
    "dev": "npm run assets --silent && vite",
    "build": "npm run assets --silent && vite build",
    "start": "vite build && node server/serve.mjs",
    "serve": "node server/serve.mjs",
    "assets": "node tools/build-assets.mjs",
    "test": "node --test \"tests/**/*.test.mjs\" \"test/**/*.test.mjs\"",
    "test:smoke": "node tools/smoke/page-smoke.mjs",
    "test:visual": "node tools/visual/snapshot.mjs --check",
    "test:visual:update": "node tools/visual/snapshot.mjs --update",
    "validate-kit": "node tools/validate-kit.mjs",
    "inspect-kit": "node tools/inspect-kit.mjs",
    "contact-sheets": "node tools/contact-sheets/contact-sheets.mjs"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.4",
    "vite": "^7.1.0"
  }
}
